// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model Tenant {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  nome                 String
  cnpj                 String
  representante        String
  cpfRepresentante     String
  rgRepresentante      String
  endereco             String
  logoUrl              String?
  dadosBancariosPadrao String?
  contratoModeloHtml   String?
  bloqueado            Boolean  @default(false)
  createdAt            DateTime @default(now())
  users                User[]
  modelosContrato      TenantContratoModelo[]
  identidades          TenantIdentidadeContratada[]
  contratosGerados     ContratoGerado[]
}

model TenantContratoModelo {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipoEvento String
  html       String
  createdAt  DateTime @default(now())

  @@unique([tenantId, tipoEvento])
}

model TenantIdentidadeContratada {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome             String
  cnpj             String
  endereco         String
  representante    String
  cpfRepresentante String
  rgRepresentante  String
  createdAt        DateTime @default(now())
  contratosGerados ContratoGerado[]

  @@unique([tenantId, nome])
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  role             Role     @default(USER)
  tenantId         String?
  tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  contratosGerados ContratoGerado[]
}

// Snapshot de cada contrato gerado, para permitir listar e corrigir dados
// depois (o formulário original não persiste nada, só renderiza o HTML).
model ContratoGerado {
  id                     String                      @id @default(cuid())
  tenantId               String
  tenant                 Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  identidadeContratadaId String?
  identidadeContratada   TenantIdentidadeContratada? @relation(fields: [identidadeContratadaId], references: [id], onDelete: SetNull)
  createdByUserId        String?
  createdByUser          User?                       @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  tipoEvento             String?

  contratante          String @default("")
  profissao            String @default("")
  docContratante       String @default("")
  telContratante       String @default("")
  endContratante       String @default("")
  dataEvento           String @default("")
  dataEventoFim        String @default("")
  dataEventoTexto      String @default("")
  horaEvento           String @default("")
  evento               String @default("")
  localEvento          String @default("")
  material             String @default("")
  quantidadeConvidados String @default("")
  duracaoHoras         String @default("")
  duracaoCerimonia     String @default("")
  duracaoRecepcao      String @default("")
  quantidadeEquipe     String @default("")
  valorTotal           String @default("")
  valorEntrada         String @default("")
  tipoEntrada          String @default("")
  valorEntrada2        String @default("")
  quantidadeParcelas   String @default("")
  valorParcela         String @default("")
  dataInicialParcelas  String @default("")
  dataFinalParcelas    String @default("")
  formaPagamento       String @default("")
  dadosBancarios       String @default("")
  cidadeAss            String @default("")
  dataContrato         String @default("")
  testemunha           String @default("")
  testemunha2          String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}
